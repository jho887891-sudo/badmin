#usda 1.0
(
    defaultPrim = "MorphOneMount"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "MorphOneMount" (
    customData = {
        string label = "TEST_PROXY composition: real chassis and arm referenced read-only; the mount override below is the only authored physics statement"
    }
)
{
    def Xform "Chassis" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        customData = {
            string source = "/home/T7/dgut/runs/cad_dev/usd/M1-4WD4S_model2601_dev.usda"
        }
        prepend references = @/home/T7/dgut/runs/cad_dev/usd/M1-4WD4S_model2601_dev.usda@
    )
    {
        float3 xformOp:scale = (0.001, 0.001, 0.001)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Xform "Arm" (
        customData = {
            string source = "/home/T7/dgut/robot_sim/assets/robots/badminton_robot/rebot_b601_rs/usd/rebot_b601_rs.usd/ReBot_Arm_RS/ReBot_Arm_RS.usda"
        }
        prepend references = @/home/T7/dgut/robot_sim/assets/robots/badminton_robot/rebot_b601_rs/usd/rebot_b601_rs.usd/ReBot_Arm_RS/ReBot_Arm_RS.usda@
    )
    {
        over "Physics"
        {
            over "root_joint"
            {
                rel physics:body0 = </MorphOneMount/Chassis>
            }
        }
    }
}

