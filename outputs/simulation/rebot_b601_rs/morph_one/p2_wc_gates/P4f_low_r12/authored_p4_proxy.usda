#usda 1.0
(
    defaultPrim = "PD"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PD" (
    customData = {
        string label = "P4 PROXY chassis: verified axles/radius from P1 v2, cylinder tread proxy"
    }
)
{
    def Xform "Chassis" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float physics:mass = 16
        double3 xformOp:translate = (0, 0, 0.367000013589859)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "body_geometry"
        {
            double3 xformOp:translate = (0, -0.002400000113993883, -0.04039999842643738)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "geometry" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 1
                float3 xformOp:scale = (0.396, 0.8, 0.132)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }
    }

    def Xform "wheel1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float physics:mass = 1
        double3 xformOp:translate = (0.2500019967556, 0.296999990940094, 0.12300000339746475)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "geometry" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.0486
            double radius = 0.103
        }
    }

    def PhysicsRevoluteJoint "joint_wheel1" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 40
        float drive:angular:physics:maxForce = 400
        float drive:angular:physics:stiffness = 0
        float drive:angular:physics:targetVelocity = 0
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "X"
        rel physics:body0 = </PD/Chassis>
        rel physics:body1 = </PD/wheel1>
        point3f physics:localPos0 = (0.250002, 0.297, -0.244)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -1000000
        float physics:upperLimit = 1000000
    }

    def Xform "wheel2" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
