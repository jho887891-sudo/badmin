# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与缓存
.pytest_cache/
.ipynb_checkpoints/

# 日志（运行日志建议进 logs/ 并忽略，实验摘要入 git）
*.log
logs/

# 大文件与本地产物（checkpoint 默认不进 git，除非刻意记录）
*.pt
*.pth
*.onnx
*.engine
*.urdf.bak
# third-party wheels are staged under assets/external/_staging/, never tracked
*.whl
# Scratch/probe/patch scripts created by agents during work must never be committed.
# A bare "_*.py" is a TRAP: it also matches "__init__.py" and "__main__.py" (both start with
# an underscore), so real package files get silently dropped from the repository. That trap
# already caught one implementer on this branch (force-added in commit aaffa9b). Negating the
# dunder names back keeps the blanket rule without the trap.
_*.py
!__*.py
_*.sh
_scratch_*.png
_probe_*.png
__pycache__/
*.pyc
# reviewer worktree mirrors (never part of the project)
.review_remote/
.review_remote2/
.review_remote*/

# bulk generated image sets and background pools: regenerable, and the repository tracks
# their manifests, reports and audit sheets instead (same policy as the P3 image set).
# Regenerate with:
#   python experiments/shuttle_capability/14_render_hifi.py --split train --n 400 --seed 1
#   python experiments/shuttle_capability/14_render_hifi.py --split val   --n 120 --seed 2
outputs/shuttle_capability/train_data/*/images/
outputs/shuttle_capability/train_data/*/labels/
outputs/shuttle_capability/train_data/bg_train/
outputs/shuttle_capability/train_data/bg_val/
outputs/shuttle_capability/train_data/bg_excluded/
outputs/shuttle_capability/real_images/backgrounds/
outputs/shuttle_capability/real_images/raw/
outputs/shuttle_capability/synthetic_3d/
# the controlled capability set: 111 images, regenerable from its own plan, so the
# manifest is what is tracked. Regenerate with:
#   python tools/generate_controlled_capability.py
outputs/shuttle_capability/controlled_capability/images/
outputs/shuttle_capability/controlled_capability/labels/
# the challenge split: its own manifest and composition table are tracked, the images are
# regenerable. Regenerate with:
#   python tools/generate_challenge_test.py
outputs/shuttle_capability/challenge_test/images/
outputs/shuttle_capability/challenge_test/labels/
# full-resolution review sheets: regenerable evidence, the committed JPEG is the overview
outputs/shuttle_detection/background_review_sheets/

# Acquired image pools: the licence/provenance CSV is the tracked record, the images themselves are
# third-party bulk data. Regenerate or re-download with the paired experiments/shuttle_detection script:
#   python experiments/shuttle_detection/03_acquire_hard_negatives.py
#   python experiments/shuttle_detection/06_acquire_hard_negatives_2.py
#   python experiments/shuttle_detection/09_acquire_real_training.py
# 36 files under this path were tracked by mistake in 32f8679 and untracked afterwards; a
# .gitignore line cannot carry an inline comment, so this one does not.
outputs/shuttle_capability/hard_negatives/raw/
outputs/shuttle_capability/hard_negatives2/raw/
outputs/shuttle_capability/real_train/raw/
# real match frames sampled from the Badminton-hit-detection rally clips: the manifest and the model's
# detections are the tracked record, the JPEGs are regenerable with tools/sample_match_frames.py
outputs/shuttle_capability/real_match_frames/images/

# scratch working areas for third-party downloads (not part of the repository)
_scratch_drive/
_scratch_matches/

# superpowers SDD workspaces (plan ledgers, briefs, review packages)
.superpowers/
