# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与缓存
.pytest_cache/
.ipynb_checkpoints/

# 日志（运行日志建议进 logs/ 并忽略，实验摘要入 git）
*.log
logs/

# 大文件与本地产物（checkpoint 默认不进 git，除非刻意记录）
*.pt
*.pth
*.onnx
*.engine
*.urdf.bak
# third-party wheels are staged under assets/external/_staging/, never tracked
*.whl
# Scratch/probe/patch scripts created by agents during work must never be committed.
# A bare "_*.py" is a TRAP: it also matches "__init__.py" and "__main__.py" (both start with
# an underscore), so real package files get silently dropped from the repository. That trap
# already caught one implementer on this branch (force-added in commit aaffa9b). Negating the
# dunder names back keeps the blanket rule without the trap.
_*.py
!__*.py
_*.sh
_scratch_*.png
_probe_*.png
__pycache__/
*.pyc
# reviewer worktree mirrors (never part of the project)
.review_remote/
.review_remote2/
.review_remote*/

# bulk generated image sets and background pools: regenerable, and the repository tracks
# their manifests, reports and audit sheets instead (same policy as the P3 image set).
# Regenerate with:
#   python experiments/shuttle_capability/14_render_hifi.py --split train --n 400 --seed 1
#   python experiments/shuttle_capability/14_render_hifi.py --split val   --n 120 --seed 2
outputs/shuttle_capability/train_data/*/images/
outputs/shuttle_capability/train_data/*/labels/
outputs/shuttle_capability/train_data/bg_train/
outputs/shuttle_capability/train_data/bg_val/
outputs/shuttle_capability/train_data/bg_excluded/
outputs/shuttle_capability/real_images/backgrounds/
outputs/shuttle_capability/real_images/raw/
outputs/shuttle_capability/synthetic_3d/
# full-resolution review sheets: regenerable evidence, the committed JPEG is the overview
outputs/shuttle_detection/background_review_sheets/

# superpowers SDD workspaces (plan ledgers, briefs, review packages)
.superpowers/
